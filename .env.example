# Copia este archivo a .env y completa los valores (NUNCA lo subas a GitHub)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Correo (opcional). Con Gmail usa una "contraseña de aplicación"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Ajustes del bot
DROP_THRESHOLD_PCT=5
WINDOW_DAYS=30
REQUEST_DELAY_SEC=2
DB_PATH=data/pricewatch.db
